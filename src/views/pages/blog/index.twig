{#
    Blog listing — Jalawi layout: breadcrumb, a featured slider of the latest
    articles (image beside date, author, title, excerpt), then every article
    as a card in two columns (image beside the text on large screens).

    | Variable | Type  | Description                                                    |
    | articles | array | each: title, excerpt, image, url, created_at, author — pending |

    The storefront doesn't serve /blog yet; until it does this page renders
    its empty state. SDK parts: <falak-breadcrumb>, <falak-slider>.
#}
{% extends "layouts.master" %}

{% block title %}{{ trans('blog.title') }} — {{ store.name }}{% endblock %}

{% block content %}
    {% set list = articles|default([]) %}
    {% set crumbs = [
        { title: trans('common.home'), url: store.url },
        { title: trans('blog.title'), url: '/blog' }
    ] %}

    <div class="container blog-page">
        <nav class="blog-page__crumbs">
            <falak-breadcrumb items="{{ crumbs|json_encode }}"></falak-breadcrumb>
        </nav>

        {% if list|length > 0 %}
            {# Featured: the latest three, one at a time. #}
            <falak-slider class="blog-feature" type="fullwidth" auto-play auto-play-delay="6000" loop pagination static-when-single show-controls="false">
                {% for article in list %}{% if loop.index <= 3 %}
                    <div class="blog-feature__slide">
                        <a class="blog-feature__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                            {% if article.image|default(null) %}<img src="{{ article.image }}" alt="" loading="lazy">{% endif %}
                        </a>
                        <div class="blog-feature__body">
                            {% set author = article.author.name|default(null) %}
                            <div class="blog-meta">
                                {% if article.created_at|default(null) %}
                                    <span class="blog-meta__item">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v12a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-12ZM4 10h16M8 3v4M16 3v4"/></svg>
                                        <time datetime="{{ article.created_at|date('Y-m-d') }}">{{ article.created_at|date('j F Y') }}</time>
                                    </span>
                                {% endif %}
                                {% if author %}
                                    <span class="blog-meta__item">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0"/></svg>
                                        <span>{{ author }}</span>
                                    </span>
                                {% endif %}
                            </div>
                            <h2 class="blog-feature__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
                            {% if article.excerpt|default(null) %}<p class="blog-feature__excerpt">{{ article.excerpt }}</p>{% endif %}
                            <a class="blog-read-more" href="{{ article.url }}">{{ trans('blog.read_more') }}</a>
                        </div>
                    </div>
                {% endif %}{% endfor %}
            </falak-slider>

            <div class="blog-list">
                {% for article in list %}
                    <article class="blog-entry">
                        <a class="blog-entry__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                            {% if article.image|default(null) %}<img src="{{ article.image }}" alt="" loading="lazy">{% endif %}
                        </a>
                        <div class="blog-entry__body">
                            {% set author = article.author.name|default(null) %}
                            <div class="blog-meta">
                                {% if article.created_at|default(null) %}
                                    <span class="blog-meta__item">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v12a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-12ZM4 10h16M8 3v4M16 3v4"/></svg>
                                        <time datetime="{{ article.created_at|date('Y-m-d') }}">{{ article.created_at|date('j F Y') }}</time>
                                    </span>
                                {% endif %}
                                {% if author %}
                                    <span class="blog-meta__item">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0"/></svg>
                                        <span>{{ author }}</span>
                                    </span>
                                {% endif %}
                            </div>
                            <h3 class="blog-entry__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
                            {% if article.excerpt|default(null) %}<p class="blog-entry__excerpt">{{ article.excerpt }}</p>{% endif %}
                            <a class="blog-read-more" href="{{ article.url }}">{{ trans('blog.read_more') }}</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <div class="empty-state__icon" aria-hidden="true">📝</div>
                <p>{{ trans('blog.no_articles') }}</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
