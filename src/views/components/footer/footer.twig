{#
    Site footer — statically included from master.twig via {% component 'footer.footer' %}

    Jalawi layout: five columns (brand + social · links · contact · Instagram
    gallery · apps), the newsletter row under them, then a primary-coloured
    bar with the copyright, the store's documents (VAT number…) and payment
    methods.

    Customizer: the platform wraps every {% component %} in draft renders, so
    this block is selectable in the preview on its own and opens the "Header &
    footer" panel. Its values come from theme.settings (theme.json groups),
    which the customizer edits by group — data-falak-* addresses a component
    blueprint's fields, so there is nothing to tag here.
#}
{% set gallery = theme.settings.get('footer_gallery')|default([]) %}
{% set gallery_link = theme.settings.get('footer_gallery_link')|default(theme.settings.get('social_instagram')) %}

<footer class="site-footer{{ theme.settings.get('footer_is_dark') ? ' site-footer--dark' : '' }}">
    <div class="site-footer__main">
        <div class="container site-footer__grid">
            <div class="site-footer__brand" data-reveal="slide-up" style="--reveal-delay: 50ms;">
                <a href="{{ store.url }}" class="site-footer__logo" aria-label="{{ store.name }}">
                    {% if store.logo %}
                        <img src="{{ store.logo }}" alt="{{ store.name }}" width="69" height="69" loading="lazy">
                    {% else %}
                        <span class="site-footer__brand-name">{{ store.name }}</span>
                    {% endif %}
                </a>
                {% if theme.settings.get('footer_about') %}
                    <p class="site-footer__about">{{ theme.settings.get('footer_about') }}</p>
                {% endif %}

                {#
                    Social accounts. Links stay in the theme's customizer settings;
                    <falak-social> owns the icon set and the markup, so a new
                    network is a platform change rather than a theme edit.
                #}
                <falak-social
                    hide-title
                    link-instagram="{{ theme.settings.get('social_instagram') }}"
                    link-x_account="{{ theme.settings.get('social_x') }}"
                    link-tiktok="{{ theme.settings.get('social_tiktok') }}"
                    link-snapchat="{{ theme.settings.get('social_snapchat') }}"
                    link-youtube="{{ theme.settings.get('social_youtube') }}"
                    link-whatsapp="{{ theme.settings.get('social_whatsapp') }}"></falak-social>
            </div>

            {# Quick links — two sources, most deliberate first:
               1. A curated footer_menu built in the Menus panel wins outright.
               2. Otherwise the `footer_links` setting from the Customizer, which
                  ships with the store's core pages as defaults so a new store
                  always has a populated column. #}
            {% set footer_links = theme.settings.get('footer_links')|default([]) %}

            {# Contact us on every store: /contact-us is a platform route
               (pages/contact.twig). Skipped only if the merchant's own links
               already point there. #}
            {% set contact_url = '/contact-us' %}
            {% set contact_title = theme.is_rtl ? 'تواصل معنا' : 'Contact us' %}
            {% set own_urls = menus.footer_menu|default([])|length > 0
                ? menus.footer_menu|map(i => i.url)|join('|')
                : footer_links|map(i => i.url|default(i['footer_links.url']))|join('|') %}
            {% set show_contact = ('|' ~ contact_url ~ '|') not in ('|' ~ own_urls ~ '|') %}

            {% if menus.footer_menu|default([])|length > 0 %}
                <nav class="site-footer__col site-footer__menu" data-reveal="slide-up" style="--reveal-delay: 100ms;" aria-labelledby="footer-links-title"
                     data-falak-field="footer_links_menu" data-falak-label="{{ trans('footer.quick_links') }}" data-falak-bind="none">
                    <h3 class="site-footer__title" id="footer-links-title">{{ trans('footer.quick_links') }}</h3>
                    <ul>
                        {% for item in menus.footer_menu %}
                            <li><a href="{{ item.url }}"{{ item.is_new_tab ? ' target="_blank" rel="noopener"' : '' }}>{{ item.title }}</a></li>
                        {% endfor %}
                        {% if show_contact %}<li><a href="{{ contact_url }}">{{ contact_title }}</a></li>{% endif %}
                    </ul>
                </nav>
            {% elseif footer_links|length > 0 or show_contact %}
                <nav class="site-footer__col site-footer__menu" data-reveal="slide-up" style="--reveal-delay: 100ms;" aria-labelledby="footer-links-title"
                     data-falak-field="footer_links" data-falak-label="{{ trans('footer.quick_links') }}" data-falak-bind="none">
                    <h3 class="site-footer__title" id="footer-links-title">{{ trans('footer.quick_links') }}</h3>
                    <ul>
                        {% for item in footer_links %}
                            {% set item_url = item.url|default(item['footer_links.url']) %}
                            {% set item_label = item.label|default(item['footer_links.label']) %}
                            {% if item_label is iterable %}
                                {% set item_label = item_label[user.language.code|default('ar')]|default(item_label.ar)|default(item_label.en) %}
                            {% endif %}
                            {% if item_url and item_label %}
                                <li><a href="{{ item_url }}">{{ item_label }}</a></li>
                            {% endif %}
                        {% endfor %}
                        {% if show_contact %}<li><a href="{{ contact_url }}">{{ contact_title }}</a></li>{% endif %}
                    </ul>
                </nav>
            {% endif %}

            {# Contact channels — the store's contact info from the dashboard
               (mobile, phone, email, WhatsApp, Telegram), rendered by the SDK.
               The component hides itself when none is on file; the column
               follows it (:has) so no orphan heading is left behind. #}
            <div class="site-footer__col site-footer__contact" data-reveal="slide-up" style="--reveal-delay: 150ms;">
                <h3 class="site-footer__title">{{ trans('footer.contact') }}</h3>
                <falak-contact-links only="mobile,phone,email,telegram" labels="false"></falak-contact-links>
            </div>

            {# Gallery — footer_gallery collection; each tile links to
               its own URL, else the gallery link / social account.
               Hover icon dynamically detects from link / title or respects customizer setting. #}
            {% if gallery|length %}
                {% set gallery_setting_icon = theme.settings.get('footer_gallery_icon')|default('auto') %}
                {% if gallery_setting_icon is iterable %}{% set gallery_setting_icon = gallery_setting_icon|first %}{% endif %}
                {% set gallery_title = theme.settings.get('footer_gallery_title') %}
                {% if not gallery_title %}
                    {% if gallery_setting_icon == 'facebook' %}
                        {% set gallery_title = 'Facebook' %}
                    {% elseif gallery_setting_icon == 'x' %}
                        {% set gallery_title = 'X' %}
                    {% elseif gallery_setting_icon == 'tiktok' %}
                        {% set gallery_title = 'TikTok' %}
                    {% elseif gallery_setting_icon == 'snapchat' %}
                        {% set gallery_title = 'Snapchat' %}
                    {% elseif gallery_setting_icon == 'youtube' %}
                        {% set gallery_title = 'YouTube' %}
                    {% elseif gallery_setting_icon == 'pinterest' %}
                        {% set gallery_title = 'Pinterest' %}
                    {% else %}
                        {% set gallery_title = trans('footer.instagram') %}
                    {% endif %}
                {% endif %}
                <div class="site-footer__col site-footer__gallery" data-reveal="slide-up" style="--reveal-delay: 200ms;">
                    <h3 class="site-footer__title">{{ gallery_title }}</h3>
                    <div class="site-footer__gallery-grid">
                        {% for tile in gallery %}
                            {% set tile_image = tile.image|default(tile['footer_gallery.image']) %}
                            {% set tile_link = tile.link|default(tile['footer_gallery.link'])|default(gallery_link) %}
                            {% if tile_image %}
                                {% set tile_tag = tile_link ? 'a' : 'span' %}
                                {% set tile_icon = tile.icon|default(tile['footer_gallery.icon']) %}
                                {% if tile_icon is iterable %}{% set tile_icon = tile_icon|first %}{% endif %}
                                {% if not tile_icon or tile_icon == 'auto' %}
                                    {% if gallery_setting_icon and gallery_setting_icon != 'auto' %}
                                        {% set tile_icon = gallery_setting_icon %}
                                    {% else %}
                                        {% set effective_url = (tile_link|default(''))|lower %}
                                        {% set title_lower = (gallery_title|default(''))|lower %}
                                        {% if 'facebook.com' in effective_url or 'fb.com' in effective_url or 'fb.watch' in effective_url or 'facebook' in title_lower or 'فيسبوك' in title_lower %}
                                            {% set tile_icon = 'facebook' %}
                                        {% elseif 'x.com' in effective_url or 'twitter.com' in effective_url or 't.co' in effective_url or 'تويتر' in title_lower or title_lower == 'x' or 'منصة إكس' in title_lower %}
                                            {% set tile_icon = 'x' %}
                                        {% elseif 'tiktok.com' in effective_url or 'tiktok' in title_lower or 'تيك توك' in title_lower %}
                                            {% set tile_icon = 'tiktok' %}
                                        {% elseif 'snapchat.com' in effective_url or 'snapchat' in title_lower or 'سناب' in title_lower %}
                                            {% set tile_icon = 'snapchat' %}
                                        {% elseif 'youtube.com' in effective_url or 'youtu.be' in effective_url or 'youtube' in title_lower or 'يوتيوب' in title_lower %}
                                            {% set tile_icon = 'youtube' %}
                                        {% elseif 'pinterest.com' in effective_url or 'pin.it' in effective_url or 'pinterest' in title_lower or 'بينتيريست' in title_lower %}
                                            {% set tile_icon = 'pinterest' %}
                                        {% elseif 'instagram.com' in effective_url or 'instagr.am' in effective_url or 'instagram' in title_lower or 'انستغرام' in title_lower %}
                                            {% set tile_icon = 'instagram' %}
                                        {% elseif tile_link %}
                                            {% set tile_icon = 'link' %}
                                        {% else %}
                                            {% set tile_icon = 'instagram' %}
                                        {% endif %}
                                    {% endif %}
                                {% endif %}
                                <{{ tile_tag }} class="site-footer__gallery-item"{% if tile_link %} href="{{ tile_link }}" target="_blank" rel="noopener"{% endif %}>
                                    <img src="{{ tile_image }}" alt="" width="62" height="62" loading="lazy">
                                    <span class="site-footer__gallery-overlay" aria-hidden="true">
                                        {% if tile_icon == 'facebook' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                                        {% elseif tile_icon == 'x' %}
                                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                                        {% elseif tile_icon == 'tiktok' %}
                                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.86 4.43c.8-.8 1.34-1.83 1.54-2.95V8.9a8.18 8.18 0 0 0 4.79 1.53V6.98a4.85 4.85 0 0 1-.6-.29z"/></svg>
                                        {% elseif tile_icon == 'snapchat' %}
                                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.002 2C8.75 2 6.54 4.29 6.54 7.02c0 .48.06.94.18 1.37-.92.21-1.6.86-1.6 1.63 0 .46.24.87.64 1.15-.09.34-.14.7-.14 1.08 0 1.25.7 2.35 1.76 2.8-.08.31-.2.61-.36.9-.36.65-.96 1.05-1.65 1.17-.4.07-.63.4-.55.78.07.35.38.6.75.6.21 0 .42-.06.61-.17.79-.47 1.63-.6 2.45-.37.76.21 1.48.74 2.22 1.27.76.54 1.56 1.11 2.5 1.11.95 0 1.74-.57 2.5-1.11.74-.53 1.46-1.06 2.22-1.27.82-.23 1.66-.1 2.45.37.19.11.4.17.61.17.37 0 .68-.25.75-.6.08-.38-.15-.71-.55-.78-.69-.12-1.29-.52-1.65-1.17-.16-.29-.28-.59-.36-.9 1.06-.45 1.76-1.55 1.76-2.8 0-.38-.05-.74-.14-1.08.4-.28.64-.69.64-1.15 0-.77-.68-1.42-1.6-1.63.12-.43.18-.89.18-1.37C17.46 4.29 15.25 2 12.002 2z"/></svg>
                                        {% elseif tile_icon == 'youtube' %}
                                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                                        {% elseif tile_icon == 'pinterest' %}
                                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
                                        {% elseif tile_icon == 'link' %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                        {% else %}
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/></svg>
                                        {% endif %}
                                    </span>
                                </{{ tile_tag }}>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# Mobile apps — renders nothing until the store
               has the data on file, so an empty column costs no layout. #}
            <div class="site-footer__col site-footer__apps" data-reveal="slide-up" style="--reveal-delay: 250ms;">
                <falak-apps-icons></falak-apps-icons>
            </div>
        </div>

        {# Newsletter — <falak-newsletter> is an SDK component: it renders its
           own field, button and aria-live status line, validates in the
           store's language, and posts through falak.newsletter.subscribe().
           The theme only skins it. #}
        {% set store_nl = store.settings.newsletter|default(store.newsletter)|default({}) %}
        {% set store_nl_enabled = store.settings.newsletter_enabled is defined ? store.settings.newsletter_enabled : (store_nl.enabled is defined ? store_nl.enabled : true) %}
        {% if store_nl_enabled and theme.settings.get('footer_newsletter_enabled', true) %}
            <div class="container site-footer__newsletter" data-reveal="slide-up" style="--reveal-delay: 120ms;">
                {% set footer_nl_title = theme.settings.get('footer_newsletter_title')|default(store.settings.newsletter_title)|default(store_nl.title)|default(trans('footer.newsletter')) %}
                {% if footer_nl_title %}
                    <h2 class="site-footer__newsletter-title">
                        {{ footer_nl_title }}
                    </h2>
                {% endif %}
                {% set footer_nl_desc = theme.settings.get('footer_newsletter_description')|default(store.settings.newsletter_description)|default(store.settings.newsletter_subtitle)|default(store_nl.description)|default(store_nl.subtitle) %}
                {% if footer_nl_desc %}
                    <p class="site-footer__newsletter-desc">{{ footer_nl_desc }}</p>
                {% endif %}
                <falak-newsletter class="site-footer__newsletter-form"></falak-newsletter>
            </div>
        {% endif %}
    </div>

    <div class="site-footer__bottom">
        <div class="container site-footer__bottom-inner" data-reveal="fade" style="--reveal-delay: 80ms;">
            <p class="site-footer__copyright">
                {{ trans('footer.rights') }} | {{ 'now'|date('Y') }}
                <a href="{{ store.url }}">{{ store.name }}</a>
            </p>

            <div class="site-footer__bottom-end">
                {# Store documents (VAT number, commercial register…) from the
                   dashboard — <falak-trust-badges> reads them and hides itself
                   when none is on file. Jalawi shows the VAT number here. #}
                <falak-trust-badges dark></falak-trust-badges>

                {# Payment methods — the component reads the store's enabled
                   payment_methods rows and collapses when there are none. #}
                <falak-payments hide-title></falak-payments>
            </div>
        </div>
    </div>
</footer>
