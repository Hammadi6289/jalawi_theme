{#
    Mega menu — a side panel that slides in from the start edge when the
    header's "Menu" button is pressed (Jalawi layout). Content comes from the
    dashboard's main menu: items with children become accordions (children,
    then a "view category" link), items without children are plain links —
    parents first, like the reference. Items that carry an image also appear
    in the image strip at the bottom. The banner on top is the header group's
    `mega_menu_image` setting, falling back to the theme's bundled banner.

    Server-rendered so crawlers and no-JS visitors still get every link;
    <falak-menu> (SDK) runs the accordions, app.js only opens/closes the panel.
    Each item: title (localized), url, is_new_tab, image, children[].
#}
{% set menu_items = menus.main_menu|default([]) %}
{% set banner = theme.settings.get('mega_menu_image')|default('images/mega-menu-banner.webp'|asset) %}

<div class="mega-overlay" data-mega-close></div>

<aside class="mega-menu" id="mega-menu" data-mega-menu aria-label="{{ trans('common.menu') }}" aria-hidden="true" inert>
    <button class="mega-menu__close" type="button" data-mega-close aria-label="{{ trans('common.close') }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6 6 18"/></svg>
    </button>

    <div class="mega-menu__content">
        {% if banner %}
            <div class="mega-menu__banner">
                <img src="{{ banner }}" alt="" loading="lazy">
            </div>
        {% endif %}

        {# <falak-menu> hydrates this server-rendered list (links stay in the
           HTML for crawlers): every <li> holding a nested <ul> becomes an
           accordion the SDK opens and closes (`mobile` = open on click, the
           item gets .is-open). Parents first, like the reference; each sub
           list ends with a "view category" link, since the parent's own
           link now toggles its list. #}
        <falak-menu class="mega-menu__nav" mobile label="{{ trans('common.menu') }}">
            <ul class="mega-menu__grid">
                {% for pass in ['parents', 'links'] %}
                    {% for item in menu_items %}
                        {% set has_children = item.children|default([])|length > 0 %}
                        {% if (pass == 'parents' and has_children) or (pass == 'links' and not has_children) %}
                            <li class="mega-menu__card">
                                <a class="mega-menu__parent" href="{{ item.url }}"{{ item.is_new_tab ? ' target="_blank" rel="noopener"' : '' }}>
                                    <span>{{ item.title }}</span>
                                    {% if has_children %}
                                        <svg class="mega-menu__arrow" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
                                    {% endif %}
                                </a>
                                {% if has_children %}
                                    <ul class="mega-menu__subs">
                                        {% for child in item.children %}
                                            <li class="mega-menu__sub">
                                                <a href="{{ child.url }}"{{ child.is_new_tab ? ' target="_blank" rel="noopener"' : '' }}>{{ child.title }}</a>
                                            </li>
                                        {% endfor %}
                                        <li class="mega-menu__sub mega-menu__sub--all">
                                            <a href="{{ item.url }}"{{ item.is_new_tab ? ' target="_blank" rel="noopener"' : '' }}>{{ trans('common.view_category') }}</a>
                                            <svg class="mega-menu__go" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6-6-6 6 6 6"/></svg>
                                        </li>
                                    </ul>
                                {% endif %}
                            </li>
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            </ul>
        </falak-menu>

        {% set has_images = false %}
        {% for item in menu_items %}{% if item.image %}{% set has_images = true %}{% endif %}{% endfor %}
        {% if has_images %}
            <div class="mega-menu__strip">
                {% for pass in ['parents', 'links'] %}
                    {% for item in menu_items %}
                        {% set has_children = item.children|default([])|length > 0 %}
                        {% if item.image and ((pass == 'parents' and has_children) or (pass == 'links' and not has_children)) %}
                            <a class="mega-menu__tile" href="{{ item.url }}"{{ item.is_new_tab ? ' target="_blank" rel="noopener"' : '' }}>
                                <span class="mega-menu__tile-media"><img src="{{ item.image }}" alt="" loading="lazy"></span>
                                <span class="mega-menu__tile-title">
                                    <span>{{ item.title }}</span>
                                    <svg class="mega-menu__go" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6-6-6 6 6 6"/></svg>
                                </span>
                            </a>
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</aside>
