{#
    Image with text — merchant-placeable content block (home + builder pages).
    | Variable                   | Type    | Description                          |
    | component.image            | string  | image URL (falls back to theme asset)|
    | component.title            | ?string | localized server-side                |
    | component.text             | ?string | localized server-side                |
    | component.button_text      | ?string | CTA label                            |
    | component.button_link_type | ?string | custom, category, product, products, home |
    | component.button_category  | ?string | category ID for button destination   |
    | component.button_product   | ?string | product ID/slug for button destination |
    | component.button_url       | ?string | custom CTA target                    |
    | component.flipped          | ?bool   | image on the end side instead        |
    | position                   | int     |                                      |

    Customizer bindings — full rules in README, "Customizer annotations".
    | Element | Tag                                                              |
    | img     | data-falak-field="image"  (an <img> binds to src by default)      |
    | h2      | data-falak-field="title"                                         |
    | p       | data-falak-field="text"                                          |
    | a.btn   | data-falak-field="button_text" data-falak-bind-href="button_url" |

    The tag goes on the <img>, not on .image-text__media: a wrapper's default
    binding is text, so the image URL would be written into it as a caption.

    Styleable parts: `body` on .image-text__body. The title, text, button and
    image are styled through their existing data-falak-field tags.
#}
{% set default_img = 'images/category-sidebar-banner.png'|asset %}
{% set raw_img = component.image|default(null) %}
{% set img_src = raw_img ? (raw_img starts with 'http' or raw_img starts with '/' or raw_img starts with 'data:' ? raw_img : raw_img|asset) : default_img %}

<section class="block block--image-text" id="image-text-{{ position }}" {{ falak_section() }}>
    <div class="container">
        <div class="image-text{{ component.flipped ? ' image-text--flipped' : '' }}">
            <div class="image-text__media" data-reveal="slide-start" style="--reveal-delay: 100ms;">
                <img data-falak-field="image" data-falak-label="{{ trans('editor.field.image') }}" src="{{ img_src }}" alt="{{ component.title|default('') }}" loading="lazy">
            </div>
            <div class="image-text__body" data-reveal="slide-end" style="--reveal-delay: 180ms;" data-falak-part="body">
                {% if component.title %}<h2 data-falak-field="title" data-falak-label="{{ trans('editor.field.title') }}">{{ component.title }}</h2>{% endif %}
                {% if component.text %}<p data-falak-field="text" data-falak-label="{{ trans('editor.field.text') }}">{{ component.text }}</p>{% endif %}

                {% if component.button_text %}
                    {% set btn_url = component.button_url|default('/products') %}
                    {% set btn_type = component.button_link_type|default(component.button_url ? 'custom' : 'products') %}
                    {% if btn_type is iterable %}{% set btn_type = btn_type|first %}{% endif %}
                    {% if btn_type == 'category' and component.button_category|default(null) %}
                        {% set btn_url = '/products?category_id[]=' ~ component.button_category %}
                    {% elseif btn_type == 'product' and component.button_product|default(null) %}
                        {% set btn_url = '/product/' ~ component.button_product %}
                    {% elseif btn_type == 'products' %}
                        {% set btn_url = '/products' %}
                    {% elseif btn_type == 'home' %}
                        {% set btn_url = '/' %}
                    {% endif %}

                    {% if btn_url %}
                        <a class="btn btn--outline" data-falak-field="button_text" data-falak-label="{{ trans('editor.field.button') }}" data-falak-bind-href="button_url" href="{{ btn_url }}">{{ component.button_text }}</a>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
</section>