    {
        "key": "falak-videos-slider",
        "path": "home.videos-slider",
        "title": {
            "ar": "شريط فيديوهات",
            "en": "Videos Slider"
        },
        "icon": "film-line",
        "preview": "images/sections/videos-slider.png",
        "is_default": false,
        "areas": [
            "home",
