                    "multilanguage": true,
                    "required": false,
                    "maxLength": 60
                },
                {
                    "id": "slides.thumb_image",
                    "type": "string",
                    "format": "image",
                    "label": {
                        "ar": "صورة البطاقة",
                        "en": "Card image"
                    },
                    "description": {
                        "ar": "اختياري — صورة بطاقة الفيديو أو الرابط أو التصنيف (افتراضياً صورة الشريحة)",
