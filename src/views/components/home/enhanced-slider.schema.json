                        {
                            "label": {
                                "ar": "رابط صفحة",
                                "en": "Page link"
                            },
                            "value": "link"
                        },
                        {
                            "label": {
                                "ar": "صورة فقط",
                                "en": "Image only"
                            },
                            "value": "image"
                        }
